# Environment configuration for CloudOps Commander
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (supports SQLite or PostgreSQL)
# Local SQLite default:
DATABASE_URL=sqlite:///./data/cloudops.db

# PostgreSQL Production / Docker Compose example:
# DATABASE_URL=postgresql://cloudops_user:cloudops_secret@postgres:5432/cloudops_db

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Investigator Engine
AI_ENGINE_ENABLED=true
AI_SIMULATION_MODE=true
